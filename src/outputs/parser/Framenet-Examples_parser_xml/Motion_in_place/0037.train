<Amr sentence="Sallanmaz o kalkışta ne mendil ne de bir kol .">
<Word name="1/sallan" positionX="750" positionY="100"/>
<Word name="-" positionX="650" positionY="200"/>
<Connection from="1/sallan" to="-" with="polarity"/>
